{
  "name": "mtgdle",
  "private": true,
  "version": "1.0.0",
  "description": "Monorepo with NestJS API, scripts, and shared common package",
  "license": "MIT",
  "workspaces": [
    "packages/api",
    "packages/eslint-config",
    "packages/front",
    "packages/shared-types"
  ],
  "scripts": {
    "build:api": "node node_modules/typescript/bin/tsc -p packages/api/tsconfig.json",
    "test": "jest --config jest.config.ts --runInBand",
    "test:unit": "jest --config jest.config.ts --runInBand",
    "test:integration": "jest --config jest.integration.config.ts --runInBand",
    "test:integration:cov": "jest --config jest.integration.config.ts --runInBand --coverage",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:browser",
    "test:cov": "jest --config jest.config.ts --runInBand --coverage",
    "test:http": "npm run test:integration",
    "build:front": "(cd packages/front && bun run build)",
    "build:shared-types": "(cd packages/shared-types && bun run build)",
    "start:api": "(cd packages/api && bun run dev)",
    "start:front": "(cd packages/front && bun run dev)",
    "start:shared-types": "(cd packages/shared-types && bun run dev)",
    "test:browser": "playwright test",
    "test:browser:ui": "playwright test --ui"
  },
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@types/lodash": "^4.17.20",
    "lodash": "^4.17.21",
    "type-fest": "^4.41.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "5.8.3"
  }
}
