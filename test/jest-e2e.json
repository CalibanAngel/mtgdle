{
  "moduleFileExtensions": ["ts", "js", "json"],
  "rootDir": "..",
  "moduleNameMapper": {
    "^@mtgdle/shared-types$": "<rootDir>/packages/shared-types/src/index.ts"
  },
  "testEnvironment": "node",
  "testRegex": "\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "tsconfig": "<rootDir>/test/tsconfig.json" }]
  }
}
